# Production Environment Template

# IMPORTANT: Copy this file to .env.production and update with your actual values

# Vercel API Base URL (from your Vercel deployment)
# Example: https://uniteda-supply-hub-api.vercel.app
VITE_API_BASE_URL=https://your-vercel-project.vercel.app

# Note: RESEND_API_KEY should ONLY be set in Vercel's environment variables
# Never include it in frontend .env files
