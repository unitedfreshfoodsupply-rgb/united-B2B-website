# Production Environment Template

# IMPORTANT: Copy this file to .env.production and update with your actual values

# Vercel API Base URL (Optional - if using Vercel bridge)
VITE_API_BASE_URL=https://your-vercel-project.vercel.app

# EmailJS Configuration (Recommended for Hostinger)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# RFQ-Specific EmailJS Account (Leave empty to use the default above)
VITE_EMAILJS_RFQ_SERVICE_ID=
VITE_EMAILJS_RFQ_TEMPLATE_ID=
VITE_EMAILJS_RFQ_PUBLIC_KEY=

# Note: RESEND_API_KEY should ONLY be set in server-side environment variables
# (Vercel or Hostinger PHP config) - never include it in frontend build.
